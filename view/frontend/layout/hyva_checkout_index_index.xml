<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="mageos.cca.hyva.checkout.visibility"
                   template="MageOS_CustomerCustomAttributes::hyva-checkout/visibility.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">MageOS\CustomerCustomAttributes\ViewModel\HyvaCheckoutVisibility</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template" name="mageos.cca.hyva.checkout.saved.address.notice"
                   template="MageOS_CustomerCustomAttributes::hyva-checkout/saved-address-notice.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">MageOS\CustomerCustomAttributes\ViewModel\HyvaCheckoutVisibility</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
