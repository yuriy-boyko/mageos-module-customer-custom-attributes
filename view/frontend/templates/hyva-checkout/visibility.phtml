declare(strict_types=1);

use MageOS\CustomerCustomAttributes\ViewModel\HyvaCheckoutVisibility;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp */
/** @var HyvaCheckoutVisibility $viewModel */

$viewModel = $block->getData('view_model');
$config = $viewModel->getConfig();
$addressLogic = $config['codes'] !== [] && (!empty($config['rules']) || !empty((array) $config['restrictions']));
$customer = $config['customer'];
$customerLogic = $customer['codes'] !== [] && (!empty($customer['rules']) || !empty((array) $customer['restrictions']));
if (!$addressLogic && !$customerLogic) {
    return;
}
?>
<script>
(function () {
    // Dependency rules in the Hyvä Checkout address forms, applied in the browser in both directions with no request. The
    // server (MageOS\CustomerCustomAttributesHyvaCheckout\Model\AttributeVisibilityModifier) renders the dependent fields with a "hidden" wrapper class when
    // their rule does not match and clears their values; this script shows and hides them as the customer changes the parent
    // fields. A hidden field is emptied so that no stale value is sent with the next update. Hidden fields are skipped by the
    // form validation.
    var config = <?= /* @noEscape */ json_encode($config, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var formIds = ['shipping', 'billing'];
    window.mageosCcaVisibility = {loaded: true};

    // The inputs of an attribute in one address form: one element, or the radio buttons or checkboxes of a group.
    function controls(formId, code) {
        var form = document.getElementById(formId);
        return form ? form.querySelectorAll('[name="' + code + '"], [name="' + code + '[]"]') : [];
    }

    function value(formId, code) {
        var elements = controls(formId, code);
        if (!elements.length) { return ''; }
        var first = elements[0];
        if (first.type === 'radio' || first.type === 'checkbox') {
            return Array.prototype.filter.call(elements, function (e) { return e.checked && e.value !== ''; })
                .map(function (e) { return e.value; }).join(',');
        }
        if (first.tagName === 'SELECT' && first.multiple) {
            return Array.prototype.filter.call(first.options, function (o) { return o.selected && o.value !== ''; })
                .map(function (o) { return o.value; }).join(',');
        }
        return first.value;
    }

    // Same resolution as Service\VisibilityResolver.
    function resolve(formId) {
        var codes = config.codes, restrictions = config.restrictions || {};
        var allowed = {}, byDependent = {}, visible = {};
        codes.forEach(function (code) {
            var groups = restrictions[code] || [];
            allowed[code] = groups.length === 0 || groups.indexOf(config.groupId) !== -1;
        });
        config.rules.forEach(function (rule) {
            if (codes.indexOf(rule.parent) !== -1 && codes.indexOf(rule.dependent) !== -1) {
                (byDependent[rule.dependent] = byDependent[rule.dependent] || []).push(rule);
            }
        });
        codes.forEach(function (code) { if (allowed[code] && !byDependent[code]) { visible[code] = true; } });
        var changed;
        do {
            changed = false;
            Object.keys(byDependent).forEach(function (dependent) {
                if (visible[dependent] || !allowed[dependent]) { return; }
                byDependent[dependent].some(function (rule) {
                    if (visible[rule.parent] && value(formId, rule.parent).split(',').indexOf(rule.option) !== -1) {
                        visible[dependent] = true;
                        changed = true;
                        return true;
                    }
                    return false;
                });
            });
        } while (changed);
        return visible;
    }

    function clear(elements) {
        Array.prototype.forEach.call(elements, function (element) {
            if (element.type === 'radio' || element.type === 'checkbox') {
                element.checked = element.type === 'radio' && element.value === '';
            } else if (element.tagName === 'SELECT') {
                if (element.selectedIndex !== -1 && element.value !== '') { element.selectedIndex = element.multiple ? -1 : 0; }
            } else if (element.value !== '') {
                element.value = '';
            }
        });
    }

    function apply() {
        formIds.forEach(function (formId) {
            var form = document.getElementById(formId);
            if (!form) { return; }
            var visible = resolve(formId);
            config.codes.forEach(function (code) {
                var elements = controls(formId, code);
                var wrapper = elements.length && elements[0].closest('.field-wrapper');
                if (!wrapper) { return; }
                if (visible[code]) {
                    wrapper.classList.remove('hidden');
                    wrapper.style.display = '';
                } else {
                    wrapper.classList.add('hidden');
                    wrapper.style.display = 'none';
                    clear(elements);
                }
            });
        });
    }

    // Customer attributes in their own checkout sections: the fields of every section of the page share the rules.
    var customer = config.customer || {codes: [], rules: [], restrictions: {}};
    function customerControls(code) {
        return document.querySelectorAll('[data-mageos-cca-customer] [name="' + code + '"], [data-mageos-cca-customer] [name="' + code + '[]"]');
    }
    function customerValue(code) {
        var elements = customerControls(code);
        if (!elements.length) { return ''; }
        var first = elements[0];
        if (first.type === 'radio' || first.type === 'checkbox') {
            return Array.prototype.filter.call(elements, function (e) { return e.checked && e.value !== ''; })
                .map(function (e) { return e.value; }).join(',');
        }
        if (first.tagName === 'SELECT' && first.multiple) {
            return Array.prototype.filter.call(first.options, function (o) { return o.selected && o.value !== ''; })
                .map(function (o) { return o.value; }).join(',');
        }
        return first.value;
    }
    function applyCustomer() {
        if (!customer.codes.length) { return; }
        var codes = customer.codes, restrictions = customer.restrictions || {};
        var allowed = {}, byDependent = {}, visible = {};
        codes.forEach(function (code) {
            var groups = restrictions[code] || [];
            allowed[code] = groups.length === 0 || groups.indexOf(config.groupId) !== -1;
        });
        customer.rules.forEach(function (rule) {
            if (codes.indexOf(rule.parent) !== -1 && codes.indexOf(rule.dependent) !== -1) {
                (byDependent[rule.dependent] = byDependent[rule.dependent] || []).push(rule);
            }
        });
        // A parent that is not on this page (the multi-step checkout shows it on another step) cannot be read here: the
        // state the server rendered is kept for such a field and for what depends on it.
        var onPage = {};
        codes.forEach(function (code) { onPage[code] = customerControls(code).length > 0; });
        var keep = {};
        codes.forEach(function (code) {
            var rules = byDependent[code] || [];
            if (rules.some(function (rule) { return !onPage[rule.parent]; })) {
                keep[code] = true;
                var wrapper = onPage[code] ? customerControls(code)[0].closest('.mageos-cca-field') : null;
                if (wrapper && !wrapper.classList.contains('hidden')) { visible[code] = true; }
            }
        });
        codes.forEach(function (code) { if (allowed[code] && !byDependent[code]) { visible[code] = true; } });
        var changed;
        do {
            changed = false;
            Object.keys(byDependent).forEach(function (dependent) {
                if (visible[dependent] || !allowed[dependent] || keep[dependent]) { return; }
                byDependent[dependent].some(function (rule) {
                    if (visible[rule.parent] && customerValue(rule.parent).split(',').indexOf(rule.option) !== -1) {
                        visible[dependent] = true;
                        changed = true;
                        return true;
                    }
                    return false;
                });
            });
        } while (changed);
        codes.forEach(function (code) {
            if (keep[code]) { return; }
            var elements = customerControls(code);
            var wrapper = elements.length && elements[0].closest('.mageos-cca-field');
            if (!wrapper) { return; }
            if (visible[code]) {
                wrapper.classList.remove('hidden');
                wrapper.style.display = '';
            } else {
                wrapper.classList.add('hidden');
                wrapper.style.display = 'none';
                clear(elements);
            }
        });
    }
    function applyAll() { apply(); applyCustomer(); }

    var timer = null;
    function schedule() { clearTimeout(timer); timer = setTimeout(applyAll, 0); }

    ['input', 'change'].forEach(function (name) {
        document.addEventListener(name, function (event) {
            if (event.target && event.target.form && /^(shipping|billing)$/.test(event.target.form.id)) { apply(); }
            if (event.target && event.target.closest && event.target.closest('[data-mageos-cca-customer]')) { applyCustomer(); }
        });
    });
    // Magewire replaces parts of the forms after each update.
    new MutationObserver(schedule).observe(document.body, {childList: true, subtree: true, attributes: true, attributeFilter: ['class']});
    applyAll();
})();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
