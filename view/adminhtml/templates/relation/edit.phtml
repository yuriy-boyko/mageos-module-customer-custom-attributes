<?php ob_start(); ?>
(function () {
    var attributes = <?= /* @noEscape */ $block->getAttributeDataJson() ?>;
    var rules = <?= /* @noEscape */ json_encode($relation['rules'] ?? [], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var deleteMessage = <?= /* @noEscape */ json_encode((string) __('Delete this relation? The attributes become visible again.')) ?>;
    var pleaseSelect = <?= /* @noEscape */ json_encode((string) __('Please select')) ?>;
    var removeLabel = <?= /* @noEscape */ json_encode((string) __('Remove')) ?>;
    var entitySelect = document.getElementById('mageos-cca-relation-entity');
    var body = document.querySelector('#mageos-cca-relation-rules tbody');

    function list() { return attributes[entitySelect.value] || []; }
    function find(code) { return list().filter(function (a) { return a.code === code; })[0]; }

    function fill(select, items, selected) {
        select.innerHTML = '';
        var empty = document.createElement('option');
        empty.value = '';
        empty.textContent = pleaseSelect;
        select.appendChild(empty);
        items.forEach(function (item) {
            var option = document.createElement('option');
            option.value = item.value;
            option.textContent = item.label;
            if (item.value === selected) { option.selected = true; }
            select.appendChild(option);
        });
    }

    function addRow(rule) {
        var index = body.children.length;
        var row = document.createElement('tr');
        row.innerHTML = '<td><select class="admin__control-select"></select></td>'
            + '<td><select class="admin__control-select"></select></td>'
            + '<td><select class="admin__control-select"></select></td>'
            + '<td><button type="button" class="action-delete"><span></span></button></td>';
        var selects = row.querySelectorAll('select');
        var parent = selects[0], option = selects[1], dependent = selects[2];
        parent.name = 'rules[' + index + '][parent]';
        option.name = 'rules[' + index + '][option]';
        dependent.name = 'rules[' + index + '][dependent]';
        row.querySelector('button span').textContent = removeLabel;

        fill(parent, list().filter(function (a) { return a.parent; }).map(function (a) { return {value: a.code, label: a.label}; }), rule && rule.parent);
        function fillOptions(selected) {
            var attribute = find(parent.value);
            fill(option, attribute ? attribute.options : [], selected);
        }
        fillOptions(rule && rule.option);
        fill(dependent, list().map(function (a) { return {value: a.code, label: a.label}; }), rule && rule.dependent);
        parent.addEventListener('change', function () { fillOptions(''); });
        row.querySelector('button').addEventListener('click', function () { row.remove(); renumber(); });
        body.appendChild(row);
    }

    function renumber() {
        Array.prototype.forEach.call(body.children, function (row, index) {
            var selects = row.querySelectorAll('select');
            ['parent', 'option', 'dependent'].forEach(function (field, i) { selects[i].name = 'rules[' + index + '][' + field + ']'; });
        });
    }

    rules.forEach(addRow);
    if (!rules.length) { addRow(null); }
    document.getElementById('mageos-cca-relation-add').addEventListener('click', function () { addRow(null); });
    entitySelect.addEventListener('change', function () { body.innerHTML = ''; addRow(null); });
    document.getElementById('mageos-cca-relation-save-continue').addEventListener('click', function () {
        document.getElementById('mageos-cca-relation-back').value = '1';
    });
    document.getElementById('mageos-cca-relation-back-button').addEventListener('click', function () {
        window.location = this.getAttribute('data-url');
    });
    var del = document.getElementById('mageos-cca-relation-delete');
    if (del) {
        del.addEventListener('click', function () {
            if (window.confirm(deleteMessage)) { document.getElementById('mageos-cca-relation-delete-form').submit(); }
        });
    }
})();
<?php $script = ob_get_clean(); ?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>

