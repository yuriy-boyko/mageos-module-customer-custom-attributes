# Settings of the store the end-to-end tests run against. Copy this file to local.env (it is ignored by git) and adjust.
# Read by run-all.sh and set-variant.sh. Never commit local.env: it holds passwords.

# Address of the store, as the browser on this machine opens it
E2E_BASE_URL=https://shop.example

# An admin account that may read orders and customers (REST suite, admin tests)
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=

# Password of the fixture customer e2e.customer@example.com. Leave empty: run-all.sh generates one and writes it here.
E2E_CUSTOMER_PASSWORD=

# Where Magento is installed on this machine (a folder with app/bootstrap.php); empty: found above this module
E2E_MAGENTO_ROOT=

# Command prefix that runs PHP and bin/magento where Magento is installed. Empty: run them directly on this machine.
# Example for Warden: "warden env exec -T php-fpm"
E2E_EXEC=

# Path of this module as seen from there (relative to the Magento root, or absolute)
E2E_MODULE_DIR=

# Address of the store as seen from there (for the REST suite) and a Host header when the name differs.
# Example from a Warden container: E2E_API_BASE_URL=http://nginx and E2E_API_HOST_HEADER=shop.example
E2E_API_BASE_URL=
E2E_API_HOST_HEADER=

# Address of a second website (store code ita, EUR, its own address forms) for the website scope tests. Empty: those tests
# are skipped. E2E_ITA_HOST is its host name as seen from the PHP side (default: the host of this address).
E2E_SECOND_BASE_URL=
E2E_ITA_HOST=

# A simple in-stock product (page path and SKU) for the checkout tests
E2E_PRODUCT_URL=/strive-shoulder-pack.html
E2E_SKU=24-MB04
