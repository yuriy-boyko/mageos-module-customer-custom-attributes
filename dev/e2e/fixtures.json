{
    "_comment": "Test fixtures for end-to-end runs on a Magento store with Hyvä Checkout. Every code starts with e2e_ so that teardown only removes what seed created. Customer attributes: 'checkout' = {position, sort, prefill}, only used when the form list contains mageos_hyva_checkout. 'display' is radio or checkbox. 'rules' are the admin form fields of the input type (input_validation, min_text_length, max_text_length, date_range_min, date_range_max).",
    "customer_forms_default": ["customer_account_create", "customer_account_edit", "mageos_hyva_checkout", "adminhtml_checkout"],
    "address_forms_default": ["customer_address_edit", "customer_register_address", "mageos_hyva_checkout", "mageos_address_text"],
    "attributes": [
        {"entity": "customer", "code": "e2e_c_text", "label": "E2E Customer Text", "input": "text",
         "checkout": {"position": "shipping_address_above", "sort": 10, "prefill": false}},
        {"entity": "customer", "code": "e2e_c_req", "label": "E2E Customer Required", "input": "text", "required": true, "forms": ["mageos_hyva_checkout", "adminhtml_checkout"],
         "checkout": {"position": "shipping_methods_above", "sort": 10, "prefill": false}},
        {"entity": "customer", "code": "e2e_c_sel", "label": "E2E Customer Select", "input": "select", "display": "radio",
         "options": ["Gold", "Silver"],
         "checkout": {"position": "payment_above", "sort": 10, "prefill": true}},
        {"entity": "customer", "code": "e2e_c_date", "label": "E2E Customer Date", "input": "date",
         "checkout": {"position": "payment_above", "sort": 20, "prefill": true}},
        {"entity": "customer", "code": "e2e_c_multi", "label": "E2E Customer Multi", "input": "multiselect", "display": "checkbox",
         "options": ["Opt 1", "Opt 2", "Opt 3"],
         "checkout": {"position": "payment_below", "sort": 10, "prefill": true}},
        {"entity": "customer", "code": "e2e_c_area", "label": "E2E Customer Area", "input": "textarea",
         "checkout": {"position": "payment_below", "sort": 20, "prefill": true}},
        {"entity": "customer", "code": "e2e_c_bool", "label": "E2E Customer Yes No", "input": "boolean", "display": "radio",
         "checkout": {"position": "order_summary", "sort": 10, "prefill": true}},
        {"entity": "customer", "code": "e2e_c_dep", "label": "E2E Customer Dependent", "input": "text",
         "checkout": {"position": "payment_below", "sort": 5, "prefill": false}},
        {"entity": "customer", "code": "e2e_c_below", "label": "E2E Customer Below Address", "input": "text",
         "checkout": {"position": "shipping_address_below", "sort": 10, "prefill": true}},
        {"entity": "customer", "code": "e2e_c_rdep", "label": "E2E Customer Required Dependent", "input": "text", "required": true,
         "checkout": {"position": "payment_below", "sort": 8, "prefill": false}},
        {"entity": "customer", "code": "e2e_c_rmulti", "label": "E2E Customer Required Multi", "input": "multiselect", "display": "checkbox", "required": true,
         "options": ["Alpha", "Beta"], "forms": ["mageos_hyva_checkout", "adminhtml_checkout"],
         "checkout": {"position": "payment_below", "sort": 9, "prefill": false}},
        {"entity": "customer", "code": "e2e_c_areq", "label": "E2E Customer Account Required", "input": "text", "required": true,
         "forms": ["customer_account_create", "customer_account_edit"]},
        {"entity": "customer", "code": "e2e_c_order", "label": "E2E Order Only", "input": "text",
         "forms": ["mageos_hyva_checkout", "adminhtml_checkout"],
         "checkout": {"position": "shipping_methods_below", "sort": 10, "prefill": false}},
        {"entity": "customer", "code": "e2e_c_account", "label": "E2E Account Only", "input": "text",
         "forms": ["customer_account_create", "customer_account_edit"]},
        {"entity": "customer", "code": "e2e_c_ws", "label": "E2E Customer Wholesale Only", "input": "text", "groups": [2],
         "forms": ["mageos_hyva_checkout", "adminhtml_checkout"],
         "checkout": {"position": "shipping_address_below", "sort": 20, "prefill": false}},
        {"entity": "customer", "code": "e2e_c_xsel", "label": "E2E Customer Cross Step Parent", "input": "select", "display": "radio",
         "options": ["Left", "Right"], "forms": ["mageos_hyva_checkout", "adminhtml_checkout"],
         "checkout": {"position": "shipping_methods_above", "sort": 20, "prefill": false}},
        {"entity": "customer", "code": "e2e_c_xdep", "label": "E2E Customer Cross Step Dependent", "input": "text",
         "forms": ["mageos_hyva_checkout", "adminhtml_checkout"],
         "checkout": {"position": "payment_below", "sort": 30, "prefill": false}},

        {"entity": "address", "code": "e2e_a_text", "label": "E2E Address Text", "input": "text"},
        {"entity": "address", "code": "e2e_a_req", "label": "E2E Address Required", "input": "text", "required": true},
        {"entity": "address", "code": "e2e_a_len", "label": "E2E Address Length", "input": "text",
         "rules": {"input_validation": "length", "min_text_length": 3, "max_text_length": 6}},
        {"entity": "address", "code": "e2e_a_email", "label": "E2E Address Email", "input": "text", "rules": {"input_validation": "email"}},
        {"entity": "address", "code": "e2e_a_num", "label": "E2E Address Number", "input": "text", "rules": {"input_validation": "numeric"}},
        {"entity": "address", "code": "e2e_a_cdep", "label": "E2E Address Checkbox Dependent", "input": "text"},
        {"entity": "address", "code": "e2e_a_ws", "label": "E2E Address Wholesale Only", "input": "text", "groups": [2]},
        {"entity": "address", "code": "e2e_a_sel", "label": "E2E Address Select", "input": "select", "display": "radio",
         "options": ["North", "South"]},
        {"entity": "address", "code": "e2e_a_multi", "label": "E2E Address Multi", "input": "multiselect",
         "options": ["Red", "Green", "Blue"]},
        {"entity": "address", "code": "e2e_a_date", "label": "E2E Address Date", "input": "date",
         "rules": {"date_range_max": "2027-12-31"}},
        {"entity": "address", "code": "e2e_a_area", "label": "E2E Address Area", "input": "textarea"},
        {"entity": "address", "code": "e2e_a_bool", "label": "E2E Address Yes No", "input": "boolean"},
        {"entity": "address", "code": "e2e_a_chk", "label": "E2E Address Check", "input": "multiselect", "display": "checkbox", "options": ["One", "Two", "Three"]},
        {"entity": "address", "code": "e2e_a_yn", "label": "E2E Address Radio Yes No", "input": "boolean", "display": "radio"},
        {"entity": "address", "code": "e2e_a_dep", "label": "E2E Address Dependent", "input": "text"},
        {"entity": "address", "code": "e2e_a_warn", "label": "E2E Address Warn", "input": "text"},
        {"entity": "address", "code": "e2e_a_noform", "label": "E2E Address No Form", "input": "text", "forms": []},
        {"entity": "address", "code": "e2e_a_mdep", "label": "E2E Address Multi Dependent", "input": "text"},
        {"entity": "address", "code": "e2e_a_rsel", "label": "E2E Address Required Parent", "input": "select", "options": ["Show", "Hide"]},
        {"entity": "address", "code": "e2e_a_rdep", "label": "E2E Address Required Dependent", "input": "text", "required": true},
        {"entity": "address", "code": "e2e_a_nroot", "label": "E2E Address Nested Root", "input": "select", "options": ["On", "Off"]},
        {"entity": "address", "code": "e2e_a_nsel", "label": "E2E Address Nested Middle", "input": "select", "options": ["Yes", "No"]},
        {"entity": "address", "code": "e2e_a_ndep", "label": "E2E Address Nested Leaf", "input": "text"},
        {"entity": "address", "code": "e2e_a_osel", "label": "E2E Address Option Parent", "input": "select", "options": ["Alpha", "Beta"]},
        {"entity": "address", "code": "e2e_a_odep", "label": "E2E Address Option Dependent", "input": "text"},
        {"entity": "address", "code": "e2e_a_xsel", "label": "E2E Address Delete Parent", "input": "select", "options": ["Alpha", "Beta"]},
        {"entity": "address", "code": "e2e_a_xdep", "label": "E2E Address Delete Dependent", "input": "text", "groups": [0, 1, 2, 3]}
    ],
    "relations": [
        {"name": "E2E customer relation", "entity": "customer",
         "rules": [
             {"parent": "e2e_c_sel", "option": "Gold", "dependent": "e2e_c_dep"},
             {"parent": "e2e_c_sel", "option": "Silver", "dependent": "e2e_c_rdep"},
             {"parent": "e2e_c_sel", "option": "Silver", "dependent": "e2e_c_rmulti"}
         ]},
        {"name": "E2E customer cross step relation", "entity": "customer",
         "rules": [{"parent": "e2e_c_xsel", "option": "Left", "dependent": "e2e_c_xdep"}]},
        {"name": "E2E address checkbox relation", "entity": "address",
         "rules": [{"parent": "e2e_a_chk", "option": "Two", "dependent": "e2e_a_cdep"}]},
        {"name": "E2E address relation", "entity": "address",
         "rules": [{"parent": "e2e_a_sel", "option": "North", "dependent": "e2e_a_dep"}]},
        {"name": "E2E address multiselect relation", "entity": "address",
         "rules": [
             {"parent": "e2e_a_multi", "option": "Red", "dependent": "e2e_a_mdep"},
             {"parent": "e2e_a_multi", "option": "Blue", "dependent": "e2e_a_mdep"}
         ]},
        {"name": "E2E address required dependent relation", "entity": "address",
         "rules": [{"parent": "e2e_a_rsel", "option": "Show", "dependent": "e2e_a_rdep"}]},
        {"name": "E2E address nested relation", "entity": "address",
         "rules": [
             {"parent": "e2e_a_nroot", "option": "On", "dependent": "e2e_a_nsel"},
             {"parent": "e2e_a_nsel", "option": "Yes", "dependent": "e2e_a_ndep"}
         ]},
        {"name": "E2E address option deletion relation", "entity": "address",
         "rules": [{"parent": "e2e_a_osel", "option": "Alpha", "dependent": "e2e_a_odep"}]},
        {"name": "E2E address attribute deletion relation", "entity": "address",
         "rules": [{"parent": "e2e_a_xsel", "option": "Alpha", "dependent": "e2e_a_xdep"}]}
    ],
    "products": [
        {"sku": "e2e-virtual-product", "name": "E2E Virtual Product", "type": "virtual", "price": 10, "qty": 100, "url_key": "e2e-virtual-product"}
    ],
    "customers": [
        {"email": "e2e.customer@example.com", "firstname": "E2E", "lastname": "Customer", "group": "General", "password_env": "E2E_CUSTOMER_PASSWORD"}
    ]
}
