{
    "_comment": "Cases for DEP19: the browser rule scripts and Service\\VisibilityResolver must agree. Each case has the form's fields (input: select, multiselect or text), the values, the rules, the group restrictions (code => allowed group ids) and the customer group. assertions.php resolve adds the PHP result.",
    "cases": [
        {"name": "no rules: every field visible",
         "fields": {"p": "select", "t": "text"}, "options": {"p": ["1", "2"]}, "values": {"p": "1", "t": "x"},
         "rules": [], "restrictions": {}, "groupId": 1},
        {"name": "the parent has the option: the dependent is shown",
         "fields": {"p": "select", "d": "text"}, "options": {"p": ["1", "2"]}, "values": {"p": "1", "d": ""},
         "rules": [{"parent": "p", "option": "1", "dependent": "d"}], "restrictions": {}, "groupId": 1},
        {"name": "another option: the dependent is hidden",
         "fields": {"p": "select", "d": "text"}, "options": {"p": ["1", "2"]}, "values": {"p": "2", "d": "typed"},
         "rules": [{"parent": "p", "option": "1", "dependent": "d"}], "restrictions": {}, "groupId": 1},
        {"name": "nested: a hidden middle field hides the leaf, whatever its value",
         "fields": {"r": "select", "m": "select", "l": "text"}, "options": {"r": ["1", "2"], "m": ["5", "6"]}, "values": {"r": "2", "m": "5", "l": ""},
         "rules": [{"parent": "r", "option": "1", "dependent": "m"}, {"parent": "m", "option": "5", "dependent": "l"}], "restrictions": {}, "groupId": 1},
        {"name": "nested: the whole chain matches",
         "fields": {"r": "select", "m": "select", "l": "text"}, "options": {"r": ["1", "2"], "m": ["5", "6"]}, "values": {"r": "1", "m": "5", "l": ""},
         "rules": [{"parent": "r", "option": "1", "dependent": "m"}, {"parent": "m", "option": "5", "dependent": "l"}], "restrictions": {}, "groupId": 1},
        {"name": "a multiple select parent with one of several options chosen",
         "fields": {"ms": "multiselect", "d": "text"}, "options": {"ms": ["1", "2", "3"]}, "values": {"ms": "1,3", "d": ""},
         "rules": [{"parent": "ms", "option": "3", "dependent": "d"}], "restrictions": {}, "groupId": 1},
        {"name": "two rules for one dependent: either is enough",
         "fields": {"a": "select", "b": "select", "d": "text"}, "options": {"a": ["1", "2"], "b": ["1", "2"]}, "values": {"a": "2", "b": "1", "d": ""},
         "rules": [{"parent": "a", "option": "1", "dependent": "d"}, {"parent": "b", "option": "1", "dependent": "d"}], "restrictions": {}, "groupId": 1},
        {"name": "a group restriction hides the field and what depends on it",
         "fields": {"p": "select", "d": "text", "t": "text"}, "options": {"p": ["1", "2"]}, "values": {"p": "1", "d": "", "t": ""},
         "rules": [{"parent": "p", "option": "1", "dependent": "d"}], "restrictions": {"p": [2]}, "groupId": 1},
        {"name": "the allowed group sees it",
         "fields": {"p": "select", "d": "text"}, "options": {"p": ["1", "2"]}, "values": {"p": "1", "d": ""},
         "rules": [{"parent": "p", "option": "1", "dependent": "d"}], "restrictions": {"p": [2, 3]}, "groupId": 3},
        {"name": "rules in a circle: neither field is shown",
         "fields": {"a": "select", "b": "select"}, "options": {"a": ["1", "2"], "b": ["1", "2"]}, "values": {"a": "1", "b": "1"},
         "rules": [{"parent": "a", "option": "1", "dependent": "b"}, {"parent": "b", "option": "1", "dependent": "a"}], "restrictions": {}, "groupId": 1}
    ]
}
