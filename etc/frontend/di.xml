    <type name="Magento\Customer\Api\CustomerRepositoryInterface">
        <plugin name="mageos_cca_storefront_form_hidden_values" type="MageOS\CustomerCustomAttributes\Plugin\StorefrontFormHiddenValues"/>
    </type>
    <type name="Magento\Customer\Api\AddressRepositoryInterface">
        <plugin name="mageos_cca_storefront_form_hidden_values" type="MageOS\CustomerCustomAttributes\Plugin\StorefrontFormHiddenValues"/>
    </type>
</config>
