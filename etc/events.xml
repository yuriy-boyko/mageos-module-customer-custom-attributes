<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Link 2: quote address values are stored by Plugin\QuoteAddressSaveValues (the save event is skipped for unchanged rows) -->
    <event name="sales_quote_address_load_after">
        <observer name="mageos_cca_quote_address_load" instance="MageOS\CustomerCustomAttributes\Observer\QuoteAddressLoadAfter"/>
    </event>
    <event name="sales_quote_address_collection_load_after">
        <observer name="mageos_cca_quote_address_collection_load" instance="MageOS\CustomerCustomAttributes\Observer\QuoteAddressLoadAfter"/>
    </event>

    <!-- Link 4: order address snapshot -->
    <event name="sales_order_address_save_after">
        <observer name="mageos_cca_order_address_save" instance="MageOS\CustomerCustomAttributes\Observer\OrderAddressSaveAfter"/>
    </event>
    <event name="sales_order_address_load_after">
        <observer name="mageos_cca_order_address_load" instance="MageOS\CustomerCustomAttributes\Observer\OrderAddressLoadAfter"/>
    </event>
    <event name="sales_order_address_collection_load_after">
        <observer name="mageos_cca_order_address_collection_load" instance="MageOS\CustomerCustomAttributes\Observer\OrderAddressLoadAfter"/>
    </event>
    <!-- Customer attributes: snapshot on the order -->
    <!-- a guest logs in while the customer has an active cart: the guest's typed customer attribute values fill the empty ones -->
    <event name="sales_quote_merge_after">
        <observer name="mageos_cca_quote_merge_customer_values" instance="MageOS\CustomerCustomAttributes\Observer\QuoteMergeCustomerValues"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="mageos_cca_validate_quote_addresses" instance="MageOS\CustomerCustomAttributes\Observer\ValidateQuoteAddresses"/>
        <observer name="mageos_cca_customer_values_to_order" instance="MageOS\CustomerCustomAttributes\Observer\QuoteSubmitBefore"/>
    </event>
    <!-- Customer attributes typed in the checkout and set to "Also Save to Customer Account" -->
    <event name="sales_model_service_quote_submit_success">
        <observer name="mageos_cca_save_checkout_values_to_account" instance="MageOS\CustomerCustomAttributes\Observer\SaveCheckoutValuesToAccount"/>
    </event>
    <!-- Order emails (new order, invoice, shipment, credit memo): the "Additional Information" section -->
    <event name="email_order_set_template_vars_before">
        <observer name="mageos_cca_order_email_additional_information" instance="MageOS\CustomerCustomAttributes\Observer\AddAdditionalInformationToEmails"/>
    </event>
    <event name="email_invoice_set_template_vars_before">
        <observer name="mageos_cca_invoice_email_additional_information" instance="MageOS\CustomerCustomAttributes\Observer\AddAdditionalInformationToEmails"/>
    </event>
    <event name="email_shipment_set_template_vars_before">
        <observer name="mageos_cca_shipment_email_additional_information" instance="MageOS\CustomerCustomAttributes\Observer\AddAdditionalInformationToEmails"/>
    </event>
    <event name="email_creditmemo_set_template_vars_before">
        <observer name="mageos_cca_creditmemo_email_additional_information" instance="MageOS\CustomerCustomAttributes\Observer\AddAdditionalInformationToEmails"/>
    </event>
    <event name="sales_order_save_after">
        <observer name="mageos_cca_order_save" instance="MageOS\CustomerCustomAttributes\Observer\OrderSaveAfter"/>
    </event>
    <event name="sales_order_load_after">
        <observer name="mageos_cca_order_load" instance="MageOS\CustomerCustomAttributes\Observer\OrderLoadAfter"/>
    </event>
    <event name="sales_order_collection_load_after">
        <observer name="mageos_cca_order_collection_load" instance="MageOS\CustomerCustomAttributes\Observer\OrderLoadAfter"/>
    </event>
</config>
