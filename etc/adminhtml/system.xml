<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="sales_email">
            <group id="mageos_cca" translate="label" type="text" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Customer Attributes (Additional Information)</label>
                <field id="add_section" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Add the Section Automatically</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Put the "Additional Information" section (the customer attributes set to "Show in Emails") into the new order, invoice, shipment and credit memo emails, below the payment and shipping method. Choose No to place it yourself in the templates you want: <code>&#123;&#123;var mageos_additional_information_html|raw&#125;&#125;</code>]]></comment>
                </field>
            </group>
        </section>
    </system>
</config>
